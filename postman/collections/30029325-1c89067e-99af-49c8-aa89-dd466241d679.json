  "item": [
    {
      "name": "Kernel",
      "item": [
        {
          "name": "Get Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/kernel/status",
              "host": ["{{base_url}}"],
              "path": ["kernel", "status"]
            }
          }
        },
        {
          "name": "Setup School",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Example High School\",\n  \"legal_name\": \"Example High School Ltd\",\n  \"email\": \"admin@example.com\",\n  \"phone\": \"+1234567890\",\n  \"address_line1\": \"123 School St\",\n  \"address_line2\": \"Suite 100\",\n  \"city\": \"Harare\",\n  \"province\": \"Harare\",\n  \"country\": \"Zimbabwe\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/kernel/setup-school",
              "host": ["{{base_url}}"],
              "path": ["kernel", "setup-school"]
            }
          }
        },
        {
          "name": "Setup Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Super Admin\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"phone\": \"+1234567890\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/kernel/setup-admin",
              "host": ["{{base_url}}"],
              "path": ["kernel", "setup-admin"]
            }
          }
