{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT id, name, description, permissions, is_system, created_at, updated_at, deleted_at\n                FROM roles\n                WHERE deleted_at IS NULL\n                  AND (name ILIKE $1 OR description ILIKE $1)\n                ORDER BY created_at DESC\n                LIMIT $2 OFFSET $3\n                ",
