  "db_name": "PostgreSQL",
  "query": "\n                SELECT id, tenant_id, name, description, permissions, is_system, created_at, updated_at, deleted_at\n                FROM roles\n                WHERE tenant_id = $1 AND deleted_at IS NULL\n                ORDER BY created_at DESC\n                LIMIT $2 OFFSET $3\n                ",
