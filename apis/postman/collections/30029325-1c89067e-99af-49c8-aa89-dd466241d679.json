    {
      "name": "Access and Licensing",
      "item": [
        {
          "name": "Get Access Catalog",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/access/catalog",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "access",
                "catalog"
              ]
            },
            "description": "Returns the canonical module and permission catalog used by the launcher and role editor."
          }
        },
        {
          "name": "List Tenant Modules",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/access/modules",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "access",
                "modules"
              ]
            },
            "description": "Lists core, grandfathered, and signed-license module entitlement states for the current tenant."
          }
        },
        {
          "name": "Get Licensing State",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/access/licensing",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "access",
                "licensing"
              ]
            },
            "description": "Returns this deployment identity, remote installation status, current lease lifecycle, modules, features, and limits."
          }
        },
        {
          "name": "Connect License Installation",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activation_code\": \"cpact_one_time_code\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/access/licensing/connect",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "access",
                "licensing",
                "connect"
              ]
            },
            "description": "Exchanges a one-time customer portal activation code for an installation credential and first signed lease."
          }
        },
        {
          "name": "Refresh License Lease",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/access/licensing/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "access",
                "licensing",
                "refresh"
              ]
            },
            "description": "Renews the signed lease using the encrypted installation credential."
          }
        },
        {
          "name": "Import Offline License Lease",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bundle\": \"{\\\"format\\\":\\\"cp-license-bundle/v1\\\",\\\"key_id\\\":\\\"key-id\\\",\\\"lease\\\":\\\"signed-jws\\\"}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/access/licensing/import",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "access",
                "licensing",
                "import"
              ]
            },
            "description": "Imports a newer signed .cp-license bundle for the connected installation."
          }
        },
        {
          "name": "Activate Legacy Signed License",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"license_key\": \"<signed-license-key>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/access/licenses/activate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "access",
                "licenses",
                "activate"
              ]
            },
            "description": "Compatibility endpoint for the previous paste-key license format. New installations use /access/licensing/connect."
          }
        },
        {
          "name": "Disable Tenant Module",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/access/modules/:module_key",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "access",
                "modules",
                ":module_key"
              ],
              "variable": [
                {
                  "key": "module_key",
                  "value": "fleet",
