# Application
APP_PORT=8000
RUST_LOG=info
SENTRY_DSN=
JWT_SECRET=change-me-to-a-random-32-char-string-in-production

# Licensing control plane
LICENSE_PUBLIC_KEY_BASE64=
LICENSE_PUBLIC_KEY_ID=production-1
LICENSE_TRUSTED_PUBLIC_KEYS_JSON=
LICENSE_ISSUER=campus-pilot-control-plane
LICENSE_AUDIENCE=campus-pilot
LICENSE_CONTROL_PLANE_URL=
LICENSE_CREDENTIAL_KEY_BASE64=
LICENSE_INSTALLATION_NAME="Campus Pilot server"

# App-managed AI provider secrets use a distinct AES-256 keyring. Values are
# standard-base64 32-byte keys; keep old key ids until every credential rotates.
AI_PROVIDER_CREDENTIAL_KEYS_JSON=
AI_PROVIDER_CREDENTIAL_ACTIVE_KEY_ID=

# Database (used by compose to create postgres + by apis)
DB_USER=campus_pilot
DB_PASS=campus_pilot
DB_NAME=campus_pilot
DB_PORT=5432

# Storage (MinIO S3 compatible)
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=campus-pilot
STORAGE_PUBLIC_ENDPOINT=https://campus-storage.antonlabs.cc
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001

# Client
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_VERSION=1.0.0
CLIENT_PORT=3000
